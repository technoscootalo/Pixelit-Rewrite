# =============================
# Pixelit Rewrite - .env.example
# Copy this file to .env and fill in real values.
# =============================

# --- MongoDB ---
# Example: mongodb://127.0.0.1:27017/Pixelit-Rewrite
MONGO_URI=

# --- Express session ---
# Use a long random string (32+ chars).
SESSION_SECRET=

# --- Server ---
# Default: 3000
PORT=3000

# --- CORS (for Socket.IO + API calls) ---
# Change this to your frontend/origin when self-hosting publicly.
# Default: http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# --- Stripe (optional) ---
# If unset, the webhook route will return an error.
SITE_URL= # --- Whatever URL you plan on hosting Pixelit ---
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Discord Bot (optional) ---
# Used by bot/bot.js. Only set these if you want the Discord integration.
BOT_TOKEN=
CLIENT_ID=
GUILD_ID=

# --- Discord Webhooks ---
# Used by server-side notifications. Set only the webhooks you want enabled.
DISCORD_WEBHOOK_AUTH=
DISCORD_WEBHOOK_BAZAAR=
DISCORD_WEBHOOK_DAILY_WHEEL=
DISCORD_WEBHOOK_PACK_OPEN=
DISCORD_WEBHOOK_TOKEN_GIFTING_ACTIVITY=
DISCORD_WEBHOOK_PIXELS_GIFTING_ACTIVITY=